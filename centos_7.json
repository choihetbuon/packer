{
    "variables": {
        "ssh_username": "vagrant",
        "ssh_password": "vagrant",
        "iso_file": "CentOS-7-x86_64-Minimal-2009.iso",
        "vm_basename": "centos-7.9x64",
        "iso_checksum_type": "sha256",
        "disk_size": "10000",
        "timeout": "30m",
        "headless": "true"
    },

    "_comment": "virtualbox-iso",
    "builders": [{
        "communicator": "ssh",
        "type": "virtualbox-iso",
        "vm_name": "{{user `vm_basename`}}",
        "disk_size": "{{user `disk_size`}}",
        "iso_urls": "{{user `iso_file`}}",
        "guest_os_type": "RedHat_64",
        "iso_checksum": "07b94e6b1a0b0260b94c83d6bb76b26bf7a310dc78d7a9c7432809fb9bc6194a",
        "http_port_min": 8336,
        "http_port_max": 8336,

        "http_directory": "http",
        "boot_wait": "5s",
        "boot_command":  [
            "<esc> <wait>",
            "linux ks=http://{{.HTTPIP}}:{{.HTTPPort}}/ks.cfg",
            "<enter><wait>"
        ],

        "shutdown_command": "echo '/sbin/halt -h -p' > /tmp/shutdown.sh; echo 'vagrant'|sudo -S sh '/tmp/shutdown.sh'",
        "ssh_username": "{{user `ssh_username`}}",
        "ssh_password": "{{user `ssh_password`}}",
        "ssh_wait_timeout": "{{user `timeout`}}",
        "ssh_handshake_attempts": "100",
        "ssh_port": 22,
        "ssh_timeout": "30m",

        "vboxmanage": [
            ["modifyvm", "{{.Name}}", "--nat-localhostreachable1", "on"],
            ["modifyvm", "{{.Name}}", "--cpus", "2" ],
            ["modifyvm", "{{.Name}}", "--usb", "off"],
            ["modifyvm", "{{.Name}}", "--audio", "none"],
            ["modifyvm", "{{.Name}}", "--memory", "4096"]
        ]
    }],

    "provisioners": [
        {
            "type": "file",
            "source": "scripts/CentOS-base.repo",
            "destination": "/tmp/CentOS-base.repo"
        },
        {
            "type": "shell",
            "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
            "inline": [
                "cp /etc/yum.repos.d/CentOS-Base.repo /etc/yum.repos.d/CentOS-Base.repo.old",
                "rm -f /etc/yum.repos.d/CentOS-Base.repo",
                "mv /tmp/CentOS-base.repo /etc/yum.repos.d/CentOS-Base.repo",
                "yum clean all",
                "rm -rf /var/cache/yum/*",
                "yum update -y",
                "yum upgrade -y",
                "cat /etc/yum.repos.d/CentOS-Base.repo"
            ]
        },
        {
            "execute_command": "echo 'vagrant' | {{.Vars}} sudo -S -E bash '{{.Path}}'",
            "type": "shell",
            "scripts": [
                "scripts/devtools.sh"
            ],
            "expect_disconnect": true,
            "pause_before": "30s",
            "timeout": "15m"
        }
    ]
}
