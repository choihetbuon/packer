{
    "variables": {
      "devtools": "false",
      "disk_size": "61440",
      "vcenter_server": "192.168.10.18",
      "vsphere_user": "administrator@vsphere.office",
      "vsphere_password": "Fimplus@2019",
      "vsphere_template_name": "Win10_withupdates",
      "vsphere_folder": "Templates",
      "vsphere_dc_name": "office",
      "vsphere_host": "192.168.10.20",
      "vsphere_network": "vlan16",
      "vsphere_datastore": "datastore1",
      "winrm_password": "vagrant",  
      "cpu_num": "8",
      "mem_size": "8192",
      "os_iso_path": "[esxi02-datastore2] ISO/Win10_22H2.iso",
      "vmtools_iso_path":"[esxi02-datastore4] ISO/windows.iso"
    },
    "sensitive-variables": [
      "vsphere_password",
      "winadmin_password"
    ],
    "builders": [
      {
        "type": "vsphere-iso",
        "username": "{{user `vsphere_user`}}",
        "password": "{{user `vsphere_password`}}",
        "vcenter_server": "{{user `vcenter_server`}}",
        "host": "{{user `vsphere_host`}}",
        "datastore": "{{user `vsphere_datastore`}}",
        "folder": "{{user `vsphere_folder`}}",
        "insecure_connection": "true",
        "convert_to_template": "true",
        "RAM_reserve_all": true, 
        "vm_name": "{{user `vsphere_template_name`}}",
        "winrm_password": "{{user `winrm_password`}}",
        "winrm_username": "vagrant",
        "communicator": "winrm",
        "RAM": "8192",
        "CPUs": "8",
        "ip_wait_timeout": "3h",
        "shutdown_timeout": "60m",
        "floppy_files": [
          "./Autounattend.xml",
          "../scripts/vmtools.cmd",
          "./unattend.xml"
        ],
        "guest_os_type": "windows9_64Guest",
        "iso_paths": [
          "{{user `os_iso_path`}}",
          "{{user `vmtools_iso_path`}}"
        ],
        "winrm_timeout": "3h",
        "shutdown_command": "c:/windows/system32/sysprep/sysprep.exe /generalize /oobe /quiet /shutdown /unattend:a:/unattend.xml && shutdown /s /t 0 /f",
        "network_adapters": [
        {
          "network": "{{user `vsphere_network`}}",
          "network_card": "vmxnet3"
        }
        ],
        "disk_controller_type": "lsilogic-sas",
        "storage": [
        {
          "disk_size": "{{user `disk_size`}}",
          "disk_thin_provisioned": true,
          "disk_controller_index": 0
        }
        ]
      }
    ],
    "provisioners": [
      {
        "type": "windows-shell",
        "inline": ["ipconfig"]
      },
      {
        "type": "powershell",
        "scripts": [
            "../scripts/disable-windows-defender.ps1",
            "../scripts/block-telemetry.ps1",
            "../scripts/remove-one-drive.ps1",
            "../scripts/enable-rdp.ps1",
            "../scripts/enable-uac.ps1",
            "../scripts/remove-apps.ps1",
            "../scripts/disable-hibernate.ps1",
            "../scripts/disable-autologin.ps1"
        ]
      },
      {
        "type": "windows-update",
        "search_criteria": "IsInstalled=0",
        "filters": [
            "exclude:$_.Title -like '*Preview*'",
            "include:$true"
        ]
      },
      {
        "type": "windows-restart",
        "restart_timeout": "10m"
      }
    ]
  }