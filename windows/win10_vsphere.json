{
    "variables": {
      "devtools": "false",
      "disk_size": "61440",
      "vcenter_server": "192.168.10.18",
      "vsphere_user": "administrator@vsphere.office",
      "vsphere_password": "Fimplus@2019",
      "vsphere_template_name": "Win10_withupdates",
      "vsphere_folder": "Templates",
      "vsphere_dc_name": "office",
      "vsphere_host": "192.168.10.20",
      "vsphere_portgroup_name": "vlan16",
      "vsphere_datastore": "esxi02-datastore4",
      "winrm_password": "123345",
      "cpu_num": "4",
      "mem_size": "4096",
      "os_iso_path": "[esxi02-datastore4] ISO/Win10_22H2_English_x64.iso",
      "iso_checksum": "af8d0e9efd3ef482d0ab365766e191e420777b2b",
      "vmtools_iso_path":""
    },
    "sensitive-variables": [
      "vsphere_password",
      "winadmin_password"
    ],
    "builders": [
      {
        "type": "vsphere-iso",
        "username": "{{user `vsphere_user`}}",
        "password": "{{user `vsphere_password`}}",
        "vcenter_server": "{{user `vcenter_server`}}",
        "host": "{{user `vsphere_host`}}",
        "datastore": "{{user `vsphere_datastore`}}",
        "folder": "{{user `vsphere_folder`}}",
        "insecure_connection": "true",
        "convert_to_template": true,
        "RAM_reserve_all": true,
        "vm_name": "{{user `vsphere_template_name`}}",
        "winrm_password": "{{user `winrm_password`}}",
        "winrm_username": "Administrator",
        "communicator": "winrm",
        "RAM": "4096",
        "CPUs": "4",
        "iso_checksum": "{{user `iso_checksum`}}",
        "floppy_files": [
          "./Autounattend.xml",
          "scripts/firstboot.ps1",
          "scripts/winrm.ps1"
        ],
        "guest_os_type": "windows9_64Guest",
        "iso_paths": [
          "{{user `os_iso_path`}}"
        ],
        "winrm_timeout": "3h",
        "shutdown_command": "c:/windows/system32/sysprep/sysprep.exe /generalize /oobe /quiet shutdown /unattend:a:/unattend.xml /s /t 10 /f /d p:4:1 /c \"Packer Shutdown\"",
        "network_adapters": [
        {
          "network": "{{user `vsphere_portgroup_name`}}",
          "network_card": "vmxnet3"
        }
        ],
        "storage": [
        {
          "disk_size": "{{user `disk_size`}}",
          "disk_thin_provisioned": true
        }
        ]
      }
    ],
    "provisioners": [
      {
        "type": "powershell",
        "scripts": [
            "scripts/disable-windows-defender.ps1",
            "scripts/block-telemetry.ps1",
            "scripts/remove-onedrive.ps1",
            "scripts/enable-rdp.ps1",
            "scripts/pass-no-expiration.ps1",
            "scripts/enable-uac.ps1",
            "scripts/remove-apps.ps1",
            "scripts/disable-hibernate.ps1",
            "scripts/disable-autologin.ps1"
        ],
        "environment_vars": ["devtools={{user `devtools`}}"]
      },
      {
        "type": "windows-update",
        "search_criteria": "IsInstalled=0",
        "filters": [
            "exclude:$_.Title -like '*Preview*'",
            "include:$true"
        ]
      },
      {
        "type": "windows-restart",
        "restart_timeout": "10m"
      }
    ],
    "post-processors": [
      {
        "compression_level": 9,
        "type": "vagrant",
        "keep_input_artifact": false,
        "provider_override": "virtualbox",
        "output": "{{.Provider}}_windows10.box"
      }
    ]
  }